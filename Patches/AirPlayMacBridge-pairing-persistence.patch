 private:
+  static constexpr time_t kPairingLifetimeSeconds = 30 * 24 * 60 * 60;
+
+  static bool validClientPublicKey(const char *publicKey)
+  {
+    if (!publicKey || strlen(publicKey) != 44)
+      return false;
+    for (size_t index = 0; index < 44; ++index)
+    {
+      const unsigned char c = (unsigned char)publicKey[index];
+      const bool base64 = (c >= 'A' && c <= 'Z') ||
+                          (c >= 'a' && c <= 'z') ||
+                          (c >= '0' && c <= '9') || c == '+' || c == '/';
+      const bool padding = c == '=' && index >= 42;
+      if (!base64 && !padding)
+        return false;
+    }
+    return true;
+  }
+
+  void loadRegisteredClients()
+  {
+    if (registrationFile_.empty())
+      return;
+    std::ifstream input(registrationFile_);
+    std::string line;
+    const time_t now = time(nullptr);
+    while (std::getline(input, line))
+    {
+      if (!line.empty() && line.back() == '\r')
+        line.pop_back();
+      const size_t comma = line.find(',');
+      if (comma != 44 || !validClientPublicKey(line.substr(0, comma).c_str()))
+        continue;
+      try
+      {
+        const time_t expiresAt = (time_t)std::stoll(line.substr(comma + 1));
+        if (expiresAt > now)
+          registeredClients_[line.substr(0, comma)] = expiresAt;
+      }
+      catch (...)
+      {
+        // Ignore malformed local state and require verification again.
+      }
+    }
+    if (!registeredClients_.empty())
+      os_log(ap_log(), "loaded %zu unexpired paired AirPlay client(s)",
+             registeredClients_.size());
+    chmod(registrationFile_.c_str(), 0600);
+  }
