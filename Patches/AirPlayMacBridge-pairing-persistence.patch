+// Keep the receiver identity and paired-client allow-list outside the app
+// bundle, private to the current macOS account. This survives app updates.
+std::string mirra_airplay_storage_directory()
+{
+  @autoreleasepool
+  {
+    NSFileManager *manager = [NSFileManager defaultManager];
+    NSURL *base = [[manager URLsForDirectory:NSApplicationSupportDirectory
+                                   inDomains:NSUserDomainMask] firstObject];
+    if (!base)
+      return {};
+
+    NSURL *directory = [base URLByAppendingPathComponent:@"Mirra" isDirectory:YES];
+    NSError *error = nil;
+    NSDictionary *attributes = @{NSFilePosixPermissions: @(0700)};
+    if (![manager createDirectoryAtURL:directory
+           withIntermediateDirectories:YES
+                            attributes:attributes
+                                 error:&error])
+    {
+      os_log_error(ap_log(), "cannot create private AirPlay storage: %{public}@", error);
+      return {};
+    }
+
+    const char *path = directory.path.fileSystemRepresentation;
+    if (!path)
+      return {};
+    chmod(path, 0700);
+    return std::string(path);
+  }
+}
+
