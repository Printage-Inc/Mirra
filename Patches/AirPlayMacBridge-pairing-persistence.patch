+  void rememberClient(const char *publicKey)
+  {
+    if (!validClientPublicKey(publicKey))
+      return;
+
+    const time_t expiresAt = time(nullptr) + kPairingLifetimeSeconds;
+    std::lock_guard<std::mutex> lk(pairingMutex_);
+    registeredClients_[publicKey] = expiresAt;
+    if (registrationFile_.empty())
+      return;
+
+    const int fd = open(registrationFile_.c_str(),
+                        O_WRONLY | O_CREAT | O_APPEND | O_CLOEXEC, 0600);
+    if (fd < 0)
+    {
+      os_log_error(ap_log(), "cannot save paired AirPlay client");
+      return;
+    }
+    fchmod(fd, 0600);
+    std::string record(publicKey);
+    record += "," + std::to_string((long long)expiresAt) + "\n";
+    const char *cursor = record.data();
+    size_t remaining = record.size();
+    while (remaining > 0)
+    {
+      const ssize_t written = write(fd, cursor, remaining);
+      if (written <= 0)
+        break;
+      cursor += written;
+      remaining -= (size_t)written;
+    }
+    close(fd);
+    if (remaining == 0)
+      os_log(ap_log(), "remembered a verified AirPlay client for 30 days");
+    else
+      os_log_error(ap_log(), "could not completely save paired AirPlay client");
+  }
